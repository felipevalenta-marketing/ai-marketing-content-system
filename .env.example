# App
APP_ENV=production
API_DEBUG=false

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Auth
JWT_SECRET_KEY=replace_with_secure_random_value
JWT_EXPIRATION_HOURS=24

# Storage
ENABLE_PERSISTENCE=true
STORAGE_ROOT=data

# Features
ENABLE_ANALYTICS=true
ENABLE_RBAC=true
ENABLE_AUTHENTICATION=true
ENABLE_MULTI_BRAND_MANAGEMENT=true
ENABLE_WORKFLOW_ORCHESTRATION=true
ENABLE_MARKDOWN_REPORTS=true
ENABLE_OBSERVABILITY=true
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_TRACKING=true
ENABLE_RUNTIME_METRICS=true
ENABLE_WORKFLOW_MONITORING=true
ENABLE_SECURITY_HARDENING=true
ENABLE_SECURITY_HEADERS=true
ENABLE_RATE_LIMITING=true
ENABLE_SECRET_SCANNING=true
ENABLE_DEPENDENCY_VALIDATION=true
ENABLE_INPUT_SANITIZATION=true
ENABLE_OUTPUT_SANITIZATION=true

# Deployment
LOG_LEVEL=info
OBSERVABILITY_LOG_LEVEL=info
REQUEST_SIZE_LIMIT_KB=256
ANONYMOUS_RATE_LIMIT_PER_HOUR=100
AUTHENTICATED_RATE_LIMIT_PER_HOUR=1000
ADMIN_RATE_LIMIT_PER_HOUR=5000

# CI
ENABLE_CI_SECURITY_CHECKS=true
ENABLE_RELEASE_VALIDATION=true
ENABLE_DOCKER_VALIDATION=true
ENABLE_MVP_ACCEPTANCE=true
ENABLE_READINESS_SCORING=true
ENABLE_RELEASE_CERTIFICATION=true
ENABLE_MATURITY_SCORING=true
